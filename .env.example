# Copiá este archivo a .env.local y completá los valores. .env.local NO se commitea.

# Supabase: Project Settings > API
# (en Vercel también se aceptan NEXT_SUPABASE_URL y NEXT_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Captcha de la reserva pública (Cloudflare Turnstile). Opcional: sin estas dos claves
# la reserva funciona igual, solo que sin captcha. Se crean en dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# service_role: SOLO en el servidor y solo si hace falta (por ejemplo, el panel de operador).
# Jamás con prefijo NEXT_PUBLIC_ ni en código de cliente. No se carga todavía.
# SUPABASE_SERVICE_ROLE_KEY=
