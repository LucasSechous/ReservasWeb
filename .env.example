# Copiá este archivo a .env.local y completá los valores. .env.local NO se commitea.

# Supabase: Project Settings > API
# (en Vercel también se aceptan NEXT_SUPABASE_URL y NEXT_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Captcha de la reserva pública (Cloudflare Turnstile). Opcional: sin estas dos claves
# la reserva funciona igual, solo que sin captcha. Se crean en dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mails (Resend). Opcional: sin RESEND_API_KEY no se manda ningún mail y todo lo demás funciona.
# MAIL_FROM tiene que ser un remitente de un dominio verificado en resend.com, por ejemplo
# "ReservasWeb <reservas@tudominio.com>". Sin MAIL_FROM se usa el remitente de pruebas de Resend,
# que solo entrega mails al dueño de la cuenta.
RESEND_API_KEY=
MAIL_FROM=

# Dirección pública de la web, para los links de los mails (https://tudominio.com).
# Opcional: si falta, se toma de la petición.
NEXT_PUBLIC_SITE_URL=

# service_role: SOLO en el servidor y solo si hace falta (por ejemplo, el panel de operador).
# Jamás con prefijo NEXT_PUBLIC_ ni en código de cliente. No se carga todavía.
# SUPABASE_SERVICE_ROLE_KEY=
